{
  "manifest_version": 3,
  "name": "Pirate Robbers",
  "version": "0.1.10",
  "description": "Grabs VideoServer and redirects to a custom player",
  "content_scripts": [
    {
      "matches": [
        "*://*.prehrajto.cz/*",
        "*://*.prehraj.to/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
